# ============================================================================
# ZENITH DISCORD BOT & WEB CONTROL PLANE — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================

# 1. DEPLOYMENT MODE
# Set ENABLE_BOT_GATEWAY="true" so the Discord Bot Gateway connects automatically on startup.
# Set to "false" ONLY if running a separate Web-Dashboard-Only frontend instance.
HEAVEN_CLOUD="false"
ENABLE_BOT_GATEWAY="true"
TEST_MODE="false"

# 2. PUBLIC APPLICATION URL & TRUSTED ORIGINS
APP_URL="https://your-dashboard-domain.run.app"
CORS_ALLOWED_ORIGINS="https://your-dashboard-domain.run.app"

# 3. DISCORD OAUTH2 AUTHENTICATION (Website Backend Only — Never expose secret to frontend)
DISCORD_CLIENT_ID="YOUR_DISCORD_APPLICATION_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_OAUTH2_CLIENT_SECRET"
DISCORD_REDIRECT_URI="https://your-dashboard-domain.run.app/auth/callback"

# 4. SESSION & CSRF SECURITY
SESSION_SECRET="REPLACE_WITH_64_CHAR_RANDOM_HEX_SESSION_SECRET"
CSRF_SECRET="REPLACE_WITH_64_CHAR_RANDOM_HEX_CSRF_SECRET"

# 5. SECURE WEBSITE-TO-BOT BRIDGE (Shared between Website Backend & HeavenCloud Bot)
BOT_BRIDGE_SECRET="REPLACE_WITH_SHARED_HMAC_SHA256_BRIDGE_SECRET"
HEAVEN_CLOUD_API_URL="https://control.heavencloud.in/api/client/servers/YOUR_SERVER_ID"
HEAVEN_CLOUD_SERVER_ID="YOUR_HEAVEN_CLOUD_SERVER_ID"
HEAVEN_CLOUD_API_KEY="YOUR_HEAVEN_CLOUD_CLIENT_API_KEY"

# 6. DISCORD BOT CREDENTIALS (Server-side only)
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_BOT_OWNER_ID="YOUR_DISCORD_OWNER_SNOWFLAKE_ID"

# 7. OPTIONAL AI / CLOUD SERVICES & GITHUB AUTO-DEPLOY
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
Github_token="YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
GITHUB_REPO_NAME="Zenith-Bot-V2"
GIT_AUTHOR_NAME="Zenith Bot"
GIT_AUTHOR_EMAIL="bot@zenith.local"


